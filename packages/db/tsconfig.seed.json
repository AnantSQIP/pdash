{
  "//": "Compiles the standalone DB scripts (seed + its catalog) to plain JS so production runs them with `node` — no ts-node/tsconfig needed in the container.",
  "//moduleResolution": "node16 rather than the deprecated node10; still emits CommonJS because @pdash/db sets no \"type\": \"module\". Emit verified identical.",
  "compilerOptions": {
    "module": "node16",
    "target": "ES2022",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmitOnError": false,
    "outDir": "prisma/dist",
    "rootDir": "prisma"
  },
  "include": [
    "prisma/seed.ts",
    "prisma/permissions-catalog.ts",
    "prisma/reset-passwords.ts",
    "prisma/set-passcode.ts",
    "prisma/regrant-roles.ts",
    "prisma/update-designations-2026-07.ts",
    "prisma/reset-operational-data.ts",
    "prisma/reset-keep-one-project.ts",
    "prisma/assign-offices.ts",
    "prisma/roster-align-2026-08.ts",
    "prisma/reporting-lines-2026-08.ts",
    "prisma/opaque-client-codes.ts",
    "prisma/seed-policies-2026-08.ts"
  ]
}
